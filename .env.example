# AccessAudit environment variables.
# Copy this file to .env and uncomment what you need. With no .env at all the app
# runs fully in test mode: mock payments, dictionary narratives, emails in /outbox.

# HTTP port the server listens on
PORT=3000

# Public base URL used in emails, Stripe redirects and the sitemap (no trailing slash)
# BASE_URL=http://localhost:3000

# Directory for the SQLite database, generated reports, screenshots and uploaded logos
# DATA_DIR=./data

# "production" requires ADMIN_PASSWORD and enables view caching; anything else is development
# NODE_ENV=development

# Stripe secret key (sk_test_... or sk_live_...); when unset, payments run in mock mode
# STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...) from `stripe listen` or the dashboard endpoint
# STRIPE_WEBHOOK_SECRET=

# Stripe price id for the $49 Site Audit (printed by `npm run stripe:setup`)
# STRIPE_PRICE_SINGLE=

# Stripe price id for the $199 Reviewed Audit
# STRIPE_PRICE_REVIEWED=

# Stripe price id for the $149 Agency 5-Pack
# STRIPE_PRICE_PACK5=

# Stripe coupon id for the FOUNDING50 founding-agency discount
# STRIPE_COUPON_FOUNDING=

# Anthropic API key for Claude-written narratives; when unset, the built-in dictionary is used
# ANTHROPIC_API_KEY=

# Claude model id used for narratives
# ANTHROPIC_MODEL=claude-opus-5

# Resend API key for outbound email; when unset, emails are stored in the local outbox
# RESEND_API_KEY=

# From address for outbound email (the domain must be verified in Resend)
# EMAIL_FROM=AccessAudit <reports@example.com>

# Password for basic auth on /admin (user "admin"); defaults to "admin" outside production
# ADMIN_PASSWORD=

# Set to 1 to allow scanning private/loopback targets (local fixtures, e2e tests only)
# ALLOW_PRIVATE_TARGETS=0

# Page cap for Site Audit and Reviewed Audit
# PAGE_LIMIT_SINGLE=15

# Page cap per site for Agency 5-Pack audits
# PAGE_LIMIT_PACK=30

# Hard timeout for one whole audit, in milliseconds
# AUDIT_TIMEOUT_MS=720000

# Free teaser scans allowed per IP per hour
# TEASER_RATE_LIMIT=5
