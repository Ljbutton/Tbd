{
  "name": "accessaudit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sample": "ALLOW_PRIVATE_TARGETS=1 tsx scripts/sample.ts",
    "stripe:setup": "tsx scripts/stripe-setup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@axe-core/playwright": "^4.13.0",
    "axe-core": "^4.13.0",
    "better-sqlite3": "^13.0.3",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "multer": "^2.4.0",
    "playwright": "1.56.1",
    "resend": "^6.28.1",
    "stripe": "^22.6.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "vitest": "^3.2.0"
  }
}
